{
  "name": "modular-character-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --force",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "test": "node --test test/*.test.mjs test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:project": "node scripts/validate-project.mjs",
    "check": "npm run typecheck && npm test && npm run validate:project",
    "export:ios": "node scripts/export-ios-demo.mjs",
    "bake:poses": "node scripts/bake-animation-library.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.5",
    "lucide-react": "1.41.0",
    "nitro": "3.0.260903-beta",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
